---
import { getCollection } from 'astro:content';

const events = (await getCollection('timeline')).sort((a, b) => a.data.order - b.data.order);

const categoryColors: Record<string, string> = {
  racing: 'bg-accent-red',
  team: 'bg-accent-cyan',
  milestone: 'bg-accent-orange',
  personal: 'bg-white',
};

const categoryBorders: Record<string, string> = {
  racing: 'border-accent-red',
  team: 'border-accent-cyan',
  milestone: 'border-accent-orange',
  personal: 'border-white',
};
---
<div class="relative">
  <!-- The line that draws on scroll -->
  <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-white/5">
    <div id="timeline-progress" class="w-full bg-accent-red origin-top" style="height: 0%;"></div>
  </div>

  <!-- Events -->
  <div class="space-y-12 md:space-y-16">
    {events.map((event, index) => (
      <div class={`timeline-event relative flex items-start gap-8 ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
        <!-- Dot -->
        <div class={`absolute left-4 md:left-1/2 w-3 h-3 rounded-full ${categoryColors[event.data.category]} -translate-x-1/2 mt-1.5 z-10 ring-4 ring-bg`}></div>

        <!-- Content -->
        <div class={`ml-12 md:ml-0 md:w-[calc(50%-2rem)] ${index % 2 === 0 ? 'md:pr-8 md:text-right' : 'md:pl-8'}`}>
          <span class="font-display text-2xl text-white">{event.data.year}</span>
          <p class={`mt-2 text-text-secondary border-l-2 ${categoryBorders[event.data.category]} pl-4 md:border-l-0 md:pl-0 ${index % 2 === 0 ? 'md:border-r-2 md:pr-4' : 'md:border-l-2 md:pl-4'}`}>
            {event.data.title}
          </p>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animate the timeline progress line
  const progress = document.getElementById('timeline-progress');
  if (progress) {
    gsap.to(progress, {
      height: '100%',
      ease: 'none',
      scrollTrigger: {
        trigger: progress.parentElement,
        start: 'top 60%',
        end: 'bottom 40%',
        scrub: 1,
      },
    });
  }

  // Animate individual events
  const events = document.querySelectorAll('.timeline-event');
  events.forEach((event, index) => {
    gsap.fromTo(event,
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: event,
          start: 'top 80%',
          toggleActions: 'play none none none',
        },
      }
    );
  });
</script>
