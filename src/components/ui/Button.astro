---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: any;
}

const { href, variant = 'primary', size = 'md', class: className = '', ...rest } = Astro.props;

const baseClasses = 'inline-flex items-center justify-center font-medium uppercase tracking-widest transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-accent-red/50 focus:ring-offset-2 focus:ring-offset-bg';

const variants = {
  primary: 'bg-accent-red text-white hover:bg-accent-red/80',
  secondary: 'border border-white/20 text-white hover:border-white/50 hover:bg-white/5',
  ghost: 'text-text-secondary hover:text-white',
};

const sizes = {
  sm: 'px-4 py-2 text-xs',
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-4 text-base',
};

const classes = `${baseClasses} ${variants[variant]} ${sizes[size]} ${className}`;

const Tag = href ? 'a' : 'button';
---
{href ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button class={classes} {...rest}>
    <slot />
  </button>
)}
