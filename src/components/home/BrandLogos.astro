---
import { brands } from '../../data/brands';
---
<section class="py-16 md:py-24 overflow-hidden border-b border-white/5">
  <div class="mb-8 text-center">
    <span class="text-xs uppercase tracking-[0.3em] text-text-muted">Trusted by the best in the business</span>
  </div>

  <div class="relative">
    <!-- Fade edges -->
    <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-bg to-transparent z-10"></div>
    <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-bg to-transparent z-10"></div>

    <!-- Scrolling container -->
    <div class="flex animate-scroll-left">
      {[...brands, ...brands].map((brand) => (
        <div class="flex-shrink-0 mx-8 md:mx-12 flex items-center justify-center h-12 md:h-16 opacity-40 hover:opacity-100 transition-opacity duration-300 grayscale hover:grayscale-0">
          <span class="font-display text-xl md:text-2xl uppercase tracking-widest text-white whitespace-nowrap">
            {brand.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
