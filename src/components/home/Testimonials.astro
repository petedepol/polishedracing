---
import { getCollection } from 'astro:content';

const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
---
<section class="py-20 md:py-32">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <span class="text-xs font-medium uppercase tracking-[0.3em] text-accent-red mb-12 block">
      From the Paddock
    </span>

    <div id="testimonial-container" class="relative min-h-[200px]">
      {testimonials.map((testimonial, index) => (
        <blockquote
          class={`testimonial-slide absolute inset-0 transition-all duration-700 ${index === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none'}`}
          data-index={index}
        >
          <p class="text-xl md:text-3xl font-light text-white leading-relaxed italic mb-8">
            "{testimonial.body}"
          </p>
          <footer>
            <cite class="not-italic">
              <span class="text-white font-medium block">{testimonial.data.author}</span>
              <span class="text-text-muted text-sm">{testimonial.data.role}</span>
            </cite>
          </footer>
        </blockquote>
      ))}
    </div>

    <!-- Dots -->
    <div class="flex justify-center gap-2 mt-12">
      {testimonials.map((_, index) => (
        <button
          class={`testimonial-dot w-2 h-2 rounded-full transition-all duration-300 ${index === 0 ? 'bg-accent-red w-6' : 'bg-text-muted/30'}`}
          data-index={index}
          aria-label={`Show testimonial ${index + 1}`}
        ></button>
      ))}
    </div>
  </div>
</section>

<script>
  const slides = document.querySelectorAll('.testimonial-slide');
  const dots = document.querySelectorAll('.testimonial-dot');
  let currentIndex = 0;
  let interval: ReturnType<typeof setInterval>;

  function showSlide(index: number) {
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('opacity-0', 'pointer-events-none');
        slide.classList.add('opacity-100');
      } else {
        slide.classList.add('opacity-0', 'pointer-events-none');
        slide.classList.remove('opacity-100');
      }
    });

    dots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.add('bg-accent-red', 'w-6');
        dot.classList.remove('bg-text-muted/30');
      } else {
        dot.classList.remove('bg-accent-red', 'w-6');
        dot.classList.add('bg-text-muted/30');
      }
    });

    currentIndex = index;
  }

  function nextSlide() {
    showSlide((currentIndex + 1) % slides.length);
  }

  // Auto-advance
  interval = setInterval(nextSlide, 5000);

  // Click handlers
  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      clearInterval(interval);
      showSlide(parseInt(dot.getAttribute('data-index') || '0'));
      interval = setInterval(nextSlide, 5000);
    });
  });
</script>
