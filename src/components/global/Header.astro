---
import { siteConfig } from '../../data/site-config';
---
<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="font-display text-2xl md:text-3xl uppercase tracking-wider text-white hover:text-accent-red transition-colors">
      Polished Racing
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
      {siteConfig.nav.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-text-secondary hover:text-white transition-colors uppercase tracking-widest"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Mobile Hamburger -->
    <button
      id="menu-toggle"
      class="md:hidden relative w-8 h-8 flex flex-col justify-center items-center gap-1.5"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="menu-line w-6 h-0.5 bg-white transition-all duration-300 origin-center"></span>
      <span class="menu-line w-6 h-0.5 bg-white transition-all duration-300 origin-center"></span>
      <span class="menu-line w-4 h-0.5 bg-white transition-all duration-300 origin-center ml-auto"></span>
    </button>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-nav" class="fixed inset-0 bg-bg/95 backdrop-blur-md z-40 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 md:hidden">
    <nav class="flex flex-col items-center gap-8" aria-label="Mobile navigation">
      {siteConfig.nav.map((item) => (
        <a
          href={item.href}
          class="font-display text-display-sm uppercase text-white hover:text-accent-red transition-colors mobile-nav-link"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  // Header scroll effect
  const header = document.getElementById('site-header');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  let isMenuOpen = false;

  function updateHeader() {
    if (!header) return;
    if (window.scrollY > 100) {
      header.classList.add('bg-bg/90', 'backdrop-blur-md', 'border-b', 'border-white/5');
    } else {
      header.classList.remove('bg-bg/90', 'backdrop-blur-md', 'border-b', 'border-white/5');
    }
  }

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  // Mobile menu toggle
  menuToggle?.addEventListener('click', () => {
    isMenuOpen = !isMenuOpen;
    menuToggle.setAttribute('aria-expanded', String(isMenuOpen));

    if (mobileNav) {
      if (isMenuOpen) {
        mobileNav.classList.remove('opacity-0', 'pointer-events-none');
        mobileNav.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';
      } else {
        mobileNav.classList.add('opacity-0', 'pointer-events-none');
        mobileNav.classList.remove('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = '';
      }
    }

    // Animate hamburger lines
    const lines = menuToggle.querySelectorAll('.menu-line');
    if (isMenuOpen) {
      (lines[0] as HTMLElement).style.transform = 'rotate(45deg) translateY(4px)';
      (lines[1] as HTMLElement).style.opacity = '0';
      (lines[2] as HTMLElement).style.transform = 'rotate(-45deg) translateY(-4px)';
      (lines[2] as HTMLElement).style.width = '1.5rem';
    } else {
      (lines[0] as HTMLElement).style.transform = '';
      (lines[1] as HTMLElement).style.opacity = '1';
      (lines[2] as HTMLElement).style.transform = '';
      (lines[2] as HTMLElement).style.width = '1rem';
    }
  });

  // Close mobile nav on link click
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (isMenuOpen) menuToggle?.click();
    });
  });
</script>
