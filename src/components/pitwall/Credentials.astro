---
import { brands } from '../../data/brands';
---
<section class="py-16">
  <div class="max-w-7xl mx-auto px-5 md:px-8">
    <p class="section-no mb-6">[12] CREDENTIALS · PROGRAMMES · PARTNERS</p>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(148px,1fr))] hairline bg-carbon">
      {brands.map(b => <span class="bg-carbon border-r border-b border-carbon-line px-4 py-3 font-mono text-[11px] tracking-[0.18em] uppercase text-ink-dim text-center whitespace-nowrap">{b}</span>)}
    </div>
    <div class="grid md:grid-cols-4 gap-px bg-carbon-line hairline mt-6">
      <div class="bg-carbon p-5"><p class="label text-signal mb-2">Certified</p><p class="font-body text-ink">Cytech professional mechanic accreditation</p></div>
      <div class="bg-carbon p-5"><p class="label text-signal mb-2">Available as</p><p class="font-body text-ink">Head mechanic · race operations &amp; logistics · performance data, acquisition and analysis · setup &amp; suspension consultancy · race software</p><p class="font-mono text-[10px] tracking-[0.12em] uppercase text-ink-faint mt-3">Open to performance-support roles across cycling disciplines</p></div>
      <div class="bg-carbon p-5"><p class="label text-signal mb-2">Polished Racing Ltd</p><p class="font-body text-ink">Suspension service business, 2015–22 · the van and the spanner below</p></div>
      <div class="bg-carbon p-5"><p class="label text-signal mb-2">Logistics</p><p class="font-body text-ink">Based in Poland (1 h from Wrocław airport) · EU-wide travel · licensed to 40 t, 8.75-t truck and 18-t motorhome experience · English &amp; Polish</p></div>
    </div>
    <div class="grid grid-cols-2 gap-px bg-carbon-line hairline mt-px max-w-3xl">
      <figure class="bg-carbon reveal"><div class="duotone overflow-hidden"><img src="/images/photos/polished-racing-van-900.webp" width="900" height="675" loading="lazy" decoding="async" alt="The Polished Racing suspension service van" class="block w-full h-auto aspect-[4/3] object-cover" /></div><figcaption class="font-mono text-[10px] tracking-[0.12em] uppercase text-ink-faint px-4 py-3">Polished Racing · the van</figcaption></figure>
      <figure class="bg-carbon reveal"><div class="duotone overflow-hidden"><img src="/images/photos/polished-racing-spanner-900.webp" width="900" height="675" loading="lazy" decoding="async" alt="A Polished Racing shock spanner in Pete’s hand" class="block w-full h-auto aspect-[4/3] object-cover" /></div><figcaption class="font-mono text-[10px] tracking-[0.12em] uppercase text-ink-faint px-4 py-3">Polished Racing · the spanner</figcaption></figure>
    </div>
  </div>
</section>
