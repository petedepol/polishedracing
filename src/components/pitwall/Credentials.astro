---
import { brands } from '../../data/brands';
---
<section class="py-16">
  <div class="max-w-7xl mx-auto px-5 md:px-8">
    <p class="section-no mb-6">[12] CREDENTIALS · PROGRAMMES · PARTNERS</p>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(148px,1fr))] gap-px bg-carbon-line hairline">
      {brands.map(b => <span class="bg-carbon px-4 py-3 font-mono text-[11px] tracking-[0.18em] uppercase text-ink-dim text-center whitespace-nowrap">{b}</span>)}
    </div>
    <div class="grid md:grid-cols-3 gap-px bg-carbon-line hairline mt-6">
      <div class="bg-carbon p-5"><p class="label text-signal mb-2">Certified</p><p class="font-body text-ink">Cytech professional mechanic accreditation</p></div>
      <div class="bg-carbon p-5"><p class="label text-signal mb-2">Available as</p><p class="font-body text-ink">Full-time head mechanic · rider mechanic · suspension &amp; setup consultancy · race-data analysis</p></div>
      <div class="bg-carbon p-5"><p class="label text-signal mb-2">Logistics</p><p class="font-body text-ink">Based in Poland (1 h from Wrocław airport) · EU-wide travel · full licence, truck-experienced · English &amp; Polish</p></div>
    </div>
  </div>
</section>
