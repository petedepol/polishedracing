---
import geometry from '../../assets/scalpel-geometry.svg?raw';
const hands = [
  { src: '/images/photos/detail-2019-bike22-1400.webp', w: 1400, h: 933, cap: '2019 · Atherton Racing · fork setup before a run' },
  { src: '/images/photos/hands-2018-fortwilliam-1400.webp', w: 1400, h: 933, cap: 'Fort William 2018 · Trek Factory Racing · tyre change' },
  { src: '/images/photos/pit-2022-cannondale-1400.webp', w: 1400, h: 933, cap: '2022 · Cannondale Factory Racing · saddle position, rider watching' },
];
---
<section id="craft" class="py-20 bg-carbon-raised border-y border-carbon-line scroll-mt-12">
  <div class="max-w-7xl mx-auto px-5 md:px-8">
    <p class="section-no mb-3">[09] CRAFT · TELEMETRY BAY</p>
    <h2 class="font-display text-display-md text-ink mb-10">THE HANDS, AND THE DATA.</h2>
    <div class="grid md:grid-cols-2 gap-px bg-carbon-line hairline">
      <div class="bg-carbon-raised p-8 reveal">
        <p class="label mb-4 text-signal">The hands</p>
        <ul class="space-y-3 font-body text-ink">
          <li><strong>Head mechanic</strong> — setup, race-day calls, the mechanical standard across a full factory roster; running a three-mechanic crew</li>
          <li><strong>Suspension specialist</strong> — Mojo/Fox background; suspension service through Polished Racing</li>
          <li><strong>Olympic build standards</strong> — two Games campaigns delivered under maximum pressure</li>
          <li><strong>Lead truck driver &amp; race logistics</strong> — 8.75-t race truck, full European calendar, long-haul rounds</li>
          <li><strong>Product development</strong> — Atherton 3D-Ti frame programme; prototype testing and sponsor feedback (Fox, Schwalbe, Cannondale, SRAM/Shimano)</li>
          <li><strong>Cytech certified</strong></li>
        </ul>
      </div>
      <div class="bg-carbon-raised p-8 reveal">
        <p class="label mb-4 text-signal">The data</p>
        <ul class="space-y-3 font-body text-ink">
          <li><strong>Per-venue setup database</strong> — every rider, every round, every pressure and click</li>
          <li><strong>Suspension telemetry</strong> — datalogger analysis to settle setup arguments with numbers</li>
          <li><strong>Tyre and pressure testing</strong> with rider power data — rolling-resistance models, not folklore</li>
          <li><strong>Race-day planning tools</strong> the team runs on every weekend — built because they didn't exist</li>
          <li><strong>Race intel loops</strong> — course analysis, weather cross-checks, post-race learning, compounding round to round</li>
        </ul>
        <p class="font-mono text-[10px] text-ink-faint mt-6 tracking-[0.12em]">BUILT BECAUSE THEY DIDN'T EXIST. IN USE EVERY RACE WEEKEND.</p>
      </div>
    </div>
    <div class="grid md:grid-cols-3 gap-px bg-carbon-line hairline mt-px">
      {hands.map(h => (
        <figure class="bg-carbon-raised reveal">
          <div class="duotone overflow-hidden"><img src={h.src} width={h.w} height={h.h} loading="lazy" decoding="async" alt={h.cap} class="block w-full h-auto aspect-[3/2] object-cover" /></div>
          <figcaption class="font-mono text-[10px] tracking-[0.12em] uppercase text-ink-faint px-4 py-3">{h.cap}</figcaption>
        </figure>
      ))}
    </div>
    <figure class="mt-px hairline bg-carbon-raised geometry-fig reveal">
      <div class="p-4 md:p-8"><Fragment set:html={geometry} /></div>
      <figcaption class="font-mono text-[10px] tracking-[0.1em] md:tracking-[0.15em] text-ink-faint px-4 md:px-8 pb-5 flex flex-wrap justify-between gap-x-6 gap-y-1 uppercase">
        <span>Fig. 02 · the bike the squad races · geometry from the manufacturer's chart, trail computed</span>
        <span class="hidden md:inline">Setup database · every rider · every round</span>
      </figcaption>
    </figure>
    <figure class="mt-px grid md:grid-cols-[1fr_minmax(0,2fr)] gap-px bg-carbon-line hairline reveal">
      <figcaption class="bg-carbon-raised p-8 flex flex-col justify-between">
        <div>
          <p class="label text-signal mb-3">Fig. 03 · Race-plan timing tool</p>
          <p class="font-body text-ink">One of the tools I built for the team: pick the race, set the start time, and every meal, activation, warm-up and pit slot is calculated backwards from the gun. Runs on a phone in the truck.</p>
        </div>
        <p class="font-mono text-[10px] text-ink-faint mt-6 tracking-[0.12em]">HTML · JS · NO BUILD STEP · V1.1 IN SERVICE SINCE 2026</p>
      </figcaption>
      <div class="bg-carbon-raised p-3 md:p-5">
        <div class="duotone hairline overflow-hidden">
          <img src="/images/kenta-calculator.webp" width="1280" height="350" loading="lazy" decoding="async" alt="Screenshot of the race-plan timing tool: a dark dashboard with the race start time and the day's schedule counted back from it" class="block w-full h-auto" />
        </div>
      </div>
    </figure>
  </div>
</section>
