---
// Fig. 02 build sheet: numbered points on the real bike (photo px, 2048×1536) + the chart geometry as a stat strip
const spots = [
  { n: 1, x: 1145, y: 724,  part: 'Cannondale Scalpel · size L', note: '120 mm front and rear. Worlds-only black paint, built for Val di Sole 2026.' },
  { n: 2, x: 1415, y: 556,  part: 'Lefty Ocho · 120 mm', note: 'Single-sided, needle bearings, 45 mm offset. Trail 111 mm with the 66.6° head angle.' },
  { n: 3, x: 935,  y: 640,  part: 'Fox Float SL', note: '190 × 45 shock, Kashima. Tune is per rider and per round.' },
  { n: 4, x: 859,  y: 1011, part: 'Shimano XTR · 12-speed', note: 'Drivetrain and brakes. One chainring, chosen for the course profile.' },
  { n: 5, x: 1751, y: 1179, part: 'Schwalbe Rick · Race Pro', note: 'Radial casing, tubeless, 29 in. Pressure set per rider on race morning.' },
  { n: 6, x: 674,  y: 387,  part: 'Fox Transfer SL', note: 'Dropper post, Kashima. Saddle height and setback recorded on the jig.' },
];
const stats = [
  { label: 'Wheelbase', value: 1207, unit: 'mm' }, { label: 'Reach', value: 475, unit: 'mm' }, { label: 'Stack', value: 604, unit: 'mm' },
  { label: 'Head angle', value: 66.6, unit: '°' }, { label: 'Chainstay', value: 442, unit: 'mm' }, { label: 'Trail', value: 111, unit: 'mm' },
];
const hands = [
  { src: '/images/photos/hands-2017-lenzerheide-laptop-1400.webp', w: 1400, h: 933, cap: 'Lenzerheide 2017 · Trek Factory Racing · lap data in the pits' },
  { src: '/images/photos/detail-2019-bike22-1400.webp', w: 1400, h: 933, cap: '2019 · Atherton Racing · fork setup before a run' },
  { src: '/images/photos/hands-2018-fortwilliam-1400.webp', w: 1400, h: 933, cap: 'Fort William 2018 · Trek Factory Racing · setting up the pits' },
  { src: '/images/photos/pit-2022-cannondale-1400.webp', w: 1400, h: 933, cap: '2022 · Cannondale Factory Racing · saddle position, rider watching' },
];
---
<section id="craft" class="py-20 bg-carbon-raised border-y border-carbon-line scroll-mt-12">
  <div class="max-w-7xl mx-auto px-5 md:px-8">
    <p class="section-no mb-3">[09] CRAFT · TELEMETRY BAY</p>
    <h2 class="font-display text-display-md text-ink mb-10">THE HANDS, AND THE DATA.</h2>
    <div class="hairline bg-carbon-raised p-8 md:p-10 grid md:grid-cols-[1fr_1.5fr] gap-8 reveal">
      <div>
        <p class="label text-signal mb-3">How I work</p>
        <p class="font-body text-ink text-xl md:text-2xl leading-snug">My job is to find the problem and make the programme better every round. The bike is where it starts, not where it ends.</p>
      </div>
      <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-3 font-body text-ink-dim text-sm self-center">
        <li><strong class="text-ink">Post-race loop</strong> — every round analysed: lap data, setup, weather, what changes next time</li>
        <li><strong class="text-ink">Setup database</strong> — every rider, every venue, every pressure and click; setup is a lookup, not an argument</li>
        <li><strong class="text-ink">Telemetry and testing</strong> — BYB suspension data, tyre and pressure tests against power files</li>
        <li><strong class="text-ink">Tools the team runs on</strong> — race-plan timing, race-day dashboards, built because they did not exist</li>
      </ul>
    </div>
    <div class="grid md:grid-cols-2 gap-px bg-carbon-line hairline mt-px">
      <div class="bg-carbon-raised p-8 reveal">
        <p class="label mb-4 text-signal">The hands</p>
        <ul class="space-y-3 font-body text-ink">
          <li><strong>Head mechanic</strong> — setup, race-day calls, the mechanical standard across a full factory roster; running a three-mechanic crew</li>
          <li><strong>Suspension specialist</strong> — Mojo/Fox background; suspension service through Polished Racing</li>
          <li><strong>Olympic build standards</strong> — two Games campaigns delivered under maximum pressure</li>
          <li><strong>Lead truck driver &amp; race logistics</strong> — 8.75-t race truck and 18-t motorhomes driven, licensed for 40-t artics; full European calendar, long-haul rounds</li>
          <li><strong>Product development</strong> — Atherton 3D-Ti frame programme; prototype testing and sponsor feedback (Fox, Schwalbe, Cannondale, SRAM/Shimano)</li>
          <li><strong>Crew building</strong> — hired Matteo Nati, Andy Lund, Joe Krejbich, Marek Ufnal and Will Soffe; for most it was their first factory-team job, and they have gone on to strong careers</li>
          <li><strong>Cytech certified</strong></li>
        </ul>
      </div>
      <div class="bg-carbon-raised p-8 reveal">
        <p class="label mb-4 text-signal">The data</p>
        <ul class="space-y-3 font-body text-ink">
          <li><strong>Per-venue setup database</strong> — every rider, every round, every pressure and click</li>
          <li><strong>Suspension telemetry</strong> — datalogger analysis to settle setup arguments with numbers</li>
          <li><strong>Tyre and pressure testing</strong> with rider power data — rolling-resistance models, not folklore</li>
          <li><strong>Race-day planning tools</strong> the team runs on every weekend — built because they didn't exist</li>
          <li><strong>Race intel loops</strong> — course analysis, weather cross-checks, post-race learning, compounding round to round</li>
        </ul>
        <p class="font-mono text-[10px] text-ink-faint mt-6 tracking-[0.12em]">BUILT BECAUSE THEY DIDN'T EXIST. IN USE EVERY RACE WEEKEND.</p>
      </div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-carbon-line hairline mt-px">
      {hands.map(h => (
        <figure class="bg-carbon-raised reveal">
          <div class="duotone overflow-hidden"><img src={h.src} width={h.w} height={h.h} loading="lazy" decoding="async" alt={h.cap} class="block w-full h-auto aspect-[3/2] object-cover" /></div>
          <figcaption class="font-mono text-[10px] tracking-[0.12em] uppercase text-ink-faint px-4 py-3">{h.cap}</figcaption>
        </figure>
      ))}
    </div>
    <figure class="mt-px hairline bg-carbon-raised geometry-fig reveal" id="build-sheet">
      <div class="grid lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] gap-px bg-carbon-line">
        <div class="geometry-stage bg-carbon-raised">
          <div class="duotone"><img src="/images/photos/bike-scalpel-worlds-2026-2048.webp" srcset="/images/photos/bike-scalpel-worlds-2026-1200.webp 1200w, /images/photos/bike-scalpel-worlds-2026-2048.webp 2048w" sizes="(min-width: 80rem) 50rem, 100vw" width="2048" height="1536" loading="lazy" decoding="async" alt="Luca Martin's black Cannondale Scalpel for the 2026 World Championships, side on, with six numbered points marking the fork, shock, drivetrain, tyres and dropper" class="block w-full h-auto" /></div>
          <svg class="geometry" viewBox="0 0 2048 1536" fill="none" font-family="JetBrains Mono, ui-monospace, monospace" aria-hidden="true">
            <defs><clipPath id="geo-clip"><rect class="geo-clip-rect" x="0" y="0" width="2048" height="1536" /></clipPath></defs>
            <g class="geo" clip-path="url(#geo-clip)">
              {spots.map(s => (
                <g class="spot" data-spot={s.n}><circle class="spot-hit" cx={s.x} cy={s.y} r="56" /><circle class="spot-ring" cx={s.x} cy={s.y} r="34" /><text class="spot-n" x={s.x} y={s.y}>{s.n}</text></g>
              ))}
            </g>
            <line class="scan" x1="0" y1="0" x2="0" y2="1536" />
          </svg>
        </div>
        <ol class="bg-carbon-raised divide-y divide-carbon-line">
          {spots.map(s => (
            <li class="spot-row flex gap-4 px-5 py-4 cursor-default" data-spot={s.n}>
              <span class="spot-badge shrink-0 w-7 h-7 rounded-full border border-signal text-signal font-mono text-[12px] font-bold flex items-center justify-center tabular">{s.n}</span>
              <div><p class="font-mono text-[11px] tracking-[0.12em] uppercase text-ink">{s.part}</p><p class="font-body text-sm text-ink-dim mt-1 leading-snug">{s.note}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <div id="geo-stats" class="grid grid-cols-3 md:grid-cols-6 gap-px bg-carbon-line border-t border-carbon-line">
        {stats.map(st => (
          <div class="bg-carbon-raised px-4 py-4"><p class="font-mono text-[10px] tracking-[0.15em] uppercase text-ink-faint">{st.label}</p><p class="font-mono text-2xl text-signal tabular mt-1"><number-flow data-target={st.value}>{st.value}</number-flow><span class="text-ink-faint text-sm ml-1">{st.unit}</span></p></div>
        ))}
      </div>
      <figcaption class="font-mono text-[10px] tracking-[0.1em] md:tracking-[0.15em] text-ink-faint px-4 md:px-8 py-5 flex flex-wrap justify-between gap-x-6 gap-y-1 uppercase">
        <span>Fig. 02 · build sheet · Luca Martin's Worlds bike · Val di Sole 2026</span>
        <span class="hidden md:inline">Geometry from Cannondale's size-L chart, trail for the team's 45 mm offset · hover for colour</span>
      </figcaption>
    </figure>
    <figure class="mt-px grid md:grid-cols-[minmax(0,2fr)_1fr] gap-px bg-carbon-line hairline reveal" id="cfr-app">
      <figcaption class="bg-carbon-raised p-8 flex flex-col justify-between">
        <div>
          <p class="label text-signal mb-3">Fig. 04 · CFR Race App · the team’s setup system</p>
          <p class="font-body text-ink">The app Cannondale Factory Racing runs on every race week, built by me. A mechanic taps a rider, picks the bike, and has the race settings in under three taps. It works offline in a pit with no signal and syncs when it finds one.</p>
          <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2 font-body text-ink-dim text-sm mt-5">
            <li><strong class="text-ink">Race-day settings</strong> — per rider, per bike, per venue</li>
            <li><strong class="text-ink">Jig measurements</strong> — saddle setback and heights against a rolling baseline; drift over 4 mm flags itself</li>
            <li><strong class="text-ink">Jig compare</strong> — two bikes side by side with the deltas</li>
            <li><strong class="text-ink">Full bike spec</strong> — every component, service history, pre-race check</li>
            <li><strong class="text-ink">Shock tune import</strong> — Fox Neo tunes photographed straight into the rider’s record</li>
            <li><strong class="text-ink">Race-week dashboard</strong> — schedule, tasks, weather, countdown</li>
          </ul>
        </div>
        <p class="font-mono text-[10px] text-ink-faint mt-6 tracking-[0.12em]">REACT PWA · SUPABASE · OFFLINE-FIRST · ROLES FOR MECHANICS, COACHES, RIDERS · IN DAILY USE SINCE 2026</p>
      </figcaption>
      <div class="bg-carbon-raised p-8 flex flex-col items-center justify-center gap-4">
        <img src="/images/cfr-app-icon-512.png" width="512" height="512" loading="lazy" decoding="async" alt="CFR Race App icon" class="w-28 h-28 md:w-36 md:h-36" />
        <p class="font-mono text-[10px] tracking-[0.15em] uppercase text-ink-faint text-center">Screens to follow · rider data stays in the team</p>
      </div>
    </figure>
    <figure class="mt-px grid md:grid-cols-[1fr_minmax(0,2fr)] gap-px bg-carbon-line hairline reveal">
      <figcaption class="bg-carbon-raised p-8 flex flex-col justify-between">
        <div>
          <p class="label text-signal mb-3">Fig. 03 · Race-plan timing tool</p>
          <p class="font-body text-ink">One of the tools I built for the team: pick the race, set the start time, and every meal, activation, warm-up and pit slot is calculated backwards from the gun. Runs on a phone in the truck.</p>
        </div>
        <p class="font-mono text-[10px] text-ink-faint mt-6 tracking-[0.12em]">HTML · JS · NO BUILD STEP · V1.1 IN SERVICE SINCE 2026</p>
      </figcaption>
      <div class="bg-carbon-raised p-3 md:p-5">
        <div class="duotone hairline overflow-hidden">
          <img src="/images/kenta-calculator.webp" width="1280" height="350" loading="lazy" decoding="async" alt="Screenshot of the race-plan timing tool: a dark dashboard with the race start time and the day's schedule counted back from it" class="block w-full h-auto" />
        </div>
      </div>
    </figure>
  </div>
</section>
