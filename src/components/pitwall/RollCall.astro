---
import { riders } from '../../data/riders';
---
<section class="py-20">
  <div class="max-w-7xl mx-auto px-5 md:px-8">
    <p class="section-no mb-3">[07] RIDER ROLL-CALL</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-carbon-line hairline mt-6">
      {riders.map((r, i) => (
        <div class="bg-carbon p-4 flex flex-col reveal" style={`transition-delay:${i*30}ms`}>
          <span class="font-body text-ink font-semibold">{r.name}</span>
          <span class="font-mono text-[10px] text-ink-dim mt-1 tracking-wide">{r.line}</span>
        </div>
      ))}
    </div>
  </div>
</section>
