---
import { siteConfig } from '../../data/site-config';
import geometry from '../../assets/scalpel-geometry.svg?raw';
---
<section id="top" class="relative min-h-svh pt-24 pb-16 blueprint-grid overflow-hidden">
  <div class="max-w-7xl mx-auto px-5 md:px-8 grid lg:grid-cols-12 gap-10 items-center min-h-[80svh]">
    <div class="lg:col-span-5">
      <p class="section-no mb-4 hero-eyebrow">[01] BUILD SHEET · 2007–2026</p>
      <h1 class="font-display text-display-xl text-ink hero-title w-max max-w-none whitespace-nowrap">PETE<br>MICHALISZYN</h1>
      <div class="hero-copy">
      <p class="font-mono text-[12px] tracking-[0.2em] uppercase text-ink-dim mt-3">"Polish Pete"<br class="md:hidden" /> · World Cup MTB head mechanic</p>
      <p class="font-body text-lg md:text-xl text-ink mt-8 max-w-md leading-snug">Two Olympic golds. Fourteen elite Worlds medals. Twenty seasons at the sharp end — most of them as head mechanic.</p>
      <div class="flex flex-wrap items-center gap-4 mt-8">
        <span class="inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.2em] uppercase text-ink border border-carbon-line px-3 py-2"><span class="dot-live"></span>{siteConfig.status}</span>
        <a href={`mailto:${siteConfig.email}`} class="btn-signal">Let's talk →</a>
      </div>
      <p class="font-mono text-[11px] text-ink-faint mt-5 flex flex-wrap gap-x-3 gap-y-1"><a href={`mailto:${siteConfig.email}`} class="py-2 hover:text-ink">{siteConfig.email}</a><span class="py-2 hidden md:inline">·</span><a href={siteConfig.whatsapp} class="py-2 hover:text-ink">{siteConfig.phone} · WhatsApp</a></p>
      </div>
    </div>

    <!-- Geometry chart: the bike the squad races, drawn from the manufacturer's published geometry (scripts/geom.py) -->
    <figure class="lg:col-span-7 geometry-fig" aria-label="Dimensioned geometry drawing of the race bike">
      <Fragment set:html={geometry} />
      <figcaption class="font-mono text-[10px] tracking-[0.1em] md:tracking-[0.15em] text-ink-faint mt-3 flex flex-wrap justify-between gap-x-6 gap-y-1 uppercase">
        <span>Fig. 01 · the bike the squad races · geometry from the manufacturer's chart, trail computed</span>
        <span class="hidden md:inline">Setup database · every rider · every round</span>
      </figcaption>
    </figure>
  </div>
  <div class="absolute bottom-6 inset-x-0 text-center section-no hero-scroll">↓ 21 VERIFIED RESULTS</div>
</section>
