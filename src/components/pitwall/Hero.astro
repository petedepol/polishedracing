---
import { siteConfig } from '../../data/site-config';
---
<section id="top" class="relative min-h-svh pt-24 pb-16 blueprint-grid overflow-hidden">
  <div class="max-w-7xl mx-auto px-5 md:px-8 grid lg:grid-cols-12 gap-10 items-center min-h-[80svh]">
    <div class="lg:col-span-5">
      <p class="section-no mb-4 hero-eyebrow">[01] BUILD SHEET · 2007–2026</p>
      <h1 class="font-display text-display-xl text-ink hero-title w-max max-w-none whitespace-nowrap">PETE<br>MICHALISZYN</h1>
      <div class="hero-copy">
      <p class="font-mono text-[12px] tracking-[0.2em] uppercase text-ink-dim mt-3">"Polish Pete" · World Cup MTB head mechanic</p>
      <p class="font-body text-lg md:text-xl text-ink mt-8 max-w-md leading-snug">Two Olympic golds. Fourteen elite Worlds medals. Twenty seasons at the sharp end — most of them as head mechanic.</p>
      <div class="flex flex-wrap items-center gap-4 mt-8">
        <span class="inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.2em] uppercase text-live border border-live/40 px-3 py-2"><span class="dot-live"></span>{siteConfig.status}</span>
        <a href={`mailto:${siteConfig.email}`} class="btn-signal">Let's talk →</a>
      </div>
      <p class="font-mono text-[11px] text-ink-faint mt-5">{siteConfig.email} · {siteConfig.phone}</p>
      </div>
    </div>

    <!-- Exploded build sheet: parts labelled with career facts, not part names -->
    <figure class="lg:col-span-7 exploded" aria-label="Exploded bike diagram labelled with career facts">
      <svg viewBox="0 0 900 560" overflow="visible" class="w-full h-auto" fill="none" stroke="#7A828C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img">
        <title>Exploded race bike — each part labelled with a career fact</title>
        <!-- rear wheel -->
        <g class="part" style="--dx:-40px;--dy:26px">
          <circle cx="200" cy="380" r="118" stroke="#AEB6BF"/><circle cx="200" cy="380" r="98"/><circle cx="200" cy="380" r="14" stroke="#EDEFF2"/>
          <g stroke="#3A4049"><line x1="200" y1="282" x2="200" y2="478"/><line x1="102" y1="380" x2="298" y2="380"/><line x1="131" y1="311" x2="269" y2="449"/><line x1="131" y1="449" x2="269" y2="311"/><line x1="152" y1="295" x2="248" y2="465"/><line x1="152" y1="465" x2="248" y2="295"/><line x1="115" y1="332" x2="285" y2="428"/><line x1="115" y1="428" x2="285" y2="332"/></g>
          <g class="callout"><line x1="130" y1="470" x2="70" y2="520" stroke="#C6FF2E"/><text x="14" y="540" font-family="JetBrains Mono, monospace" font-size="12" fill="#C6FF2E" stroke="none" letter-spacing="1.5">14 WORLDS MEDALS</text><text x="14" y="556" font-family="JetBrains Mono, monospace" font-size="10" fill="#8B93A0" stroke="none">6 GOLD · 6 SILVER · 2 BRONZE</text></g>
        </g>
        <!-- front wheel -->
        <g class="part" style="--dx:44px;--dy:26px">
          <circle cx="700" cy="380" r="118" stroke="#AEB6BF"/><circle cx="700" cy="380" r="98"/><circle cx="700" cy="380" r="14" stroke="#E9B949"/>
          <g stroke="#3A4049"><line x1="700" y1="282" x2="700" y2="478"/><line x1="602" y1="380" x2="798" y2="380"/><line x1="631" y1="311" x2="769" y2="449"/><line x1="631" y1="449" x2="769" y2="311"/><line x1="652" y1="295" x2="748" y2="465"/><line x1="652" y1="465" x2="748" y2="295"/><line x1="615" y1="332" x2="785" y2="428"/><line x1="615" y1="428" x2="785" y2="332"/></g>
          <g class="callout"><line x1="714" y1="380" x2="800" y2="500" stroke="#E9B949"/><text x="700" y="526" font-family="JetBrains Mono, monospace" font-size="12" fill="#E9B949" stroke="none" letter-spacing="1.5">2× OLYMPIC GOLD</text><text x="700" y="544" font-family="JetBrains Mono, monospace" font-size="10" fill="#8B93A0" stroke="none">TOKYO 2020 · PARIS 2024</text></g>
        </g>
        <!-- frame -->
        <g class="part" style="--dx:0;--dy:-30px">
          <polyline points="215,370 395,225 590,225 690,380 395,370 215,370" stroke="#EDEFF2" stroke-width="2.2"/>
          <line x1="395" y1="225" x2="395" y2="370" stroke="#EDEFF2" stroke-width="2.2"/>
          <line x1="395" y1="370" x2="215" y2="370" stroke="#EDEFF2"/>
          <g class="callout"><line x1="490" y1="225" x2="490" y2="150" stroke="#C6FF2E"/><text x="400" y="138" font-family="JetBrains Mono, monospace" font-size="12" fill="#C6FF2E" stroke="none" letter-spacing="1.5">20 SEASONS · WORLD CUP LEVEL</text><text x="400" y="120" font-family="JetBrains Mono, monospace" font-size="10" fill="#8B93A0" stroke="none">MOJO 2007 → CFR 2026 · HEAD MECHANIC 11 YRS</text></g>
        </g>
        <!-- fork -->
        <g class="part" style="--dx:70px;--dy:-40px">
          <line x1="590" y1="225" x2="690" y2="380" stroke="#AEB6BF" stroke-width="2.4"/><line x1="583" y1="235" x2="683" y2="390" stroke="#3A4049"/>
          <rect x="605" y="240" width="30" height="60" transform="rotate(-33 620 270)" stroke="#AEB6BF"/>
          <g class="callout"><line x1="690" y1="300" x2="800" y2="330" stroke="#C6FF2E"/><text x="890" y="330" text-anchor="end" font-family="JetBrains Mono, monospace" font-size="12" fill="#C6FF2E" stroke="none" letter-spacing="1.5">SUSPENSION</text><text x="890" y="346" text-anchor="end" font-family="JetBrains Mono, monospace" font-size="10" fill="#8B93A0" stroke="none">MOJO / FOX · TELEMETRY</text></g>
        </g>
        <!-- cockpit -->
        <g class="part" style="--dx:30px;--dy:-70px">
          <line x1="590" y1="225" x2="600" y2="190" stroke="#EDEFF2" stroke-width="2"/><line x1="560" y1="188" x2="650" y2="180" stroke="#EDEFF2" stroke-width="3"/>
          <g class="callout"><line x1="650" y1="180" x2="740" y2="120" stroke="#C6FF2E"/><text x="890" y="108" text-anchor="end" font-family="JetBrains Mono, monospace" font-size="12" fill="#C6FF2E" stroke="none" letter-spacing="1.5">THE MECHANIC WHO CODES</text><text x="890" y="92" text-anchor="end" font-family="JetBrains Mono, monospace" font-size="10" fill="#8B93A0" stroke="none">RACE-DAY TOOLS · SETUP DATABASE</text></g>
        </g>
        <!-- saddle -->
        <g class="part" style="--dx:-20px;--dy:-72px">
          <line x1="395" y1="225" x2="385" y2="185" stroke="#EDEFF2" stroke-width="2"/><path d="M345 180 Q385 170 425 182" stroke="#EDEFF2" stroke-width="3"/>
        </g>
        <!-- drivetrain -->
        <g class="part" style="--dx:-10px;--dy:70px">
          <circle cx="395" cy="370" r="34" stroke="#AEB6BF"/><circle cx="395" cy="370" r="6" stroke="#EDEFF2"/><circle cx="200" cy="380" r="40" stroke="#3A4049" stroke-dasharray="3 4"/>
          <line x1="395" y1="336" x2="200" y2="340" stroke="#3A4049" stroke-dasharray="2 5"/><line x1="395" y1="404" x2="200" y2="420" stroke="#3A4049" stroke-dasharray="2 5"/>
          <g class="callout"><line x1="395" y1="404" x2="420" y2="500" stroke="#C6FF2E"/><text x="330" y="526" font-family="JetBrains Mono, monospace" font-size="12" fill="#C6FF2E" stroke="none" letter-spacing="1.5">134 WC TOP FINISHES</text><text x="330" y="544" font-family="JetBrains Mono, monospace" font-size="10" fill="#8B93A0" stroke="none">2011–2026 · UCI WORLD CUP ONLY</text></g>
        </g>
      </svg>
    </figure>
  </div>
  <div class="absolute bottom-6 inset-x-0 text-center section-no hero-scroll">SCROLL · FEED POPULATES ↓</div>
</section>
