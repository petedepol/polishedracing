---
import { development } from '../../data/palmares';
const medalClass: Record<string,string> = { GOLD: 'text-gold', SILVER: 'text-silver', BRONZE: 'text-bronze', WIN: 'text-signal', LEADER: 'text-signal' };
---
<section class="py-20">
  <div class="max-w-7xl mx-auto px-5 md:px-8">
    <p class="section-no mb-3">[09] RIDER DEVELOPMENT · JUNIOR / U23 WORLDS MEDALS</p>
    <h2 class="font-display text-display-md text-ink mb-8">I BUILD CHAMPIONS, NOT JUST BIKES.</h2>
    <div class="hairline bg-carbon-raised divide-y divide-carbon-line">
      {development.map((r, i) => (
        <div class="feed-row grid grid-cols-[3rem_1fr_auto] md:grid-cols-[3rem_1fr_1fr_5rem_1fr] gap-3 items-center px-4 py-3 font-mono text-[12px]" style={`transition-delay:${i*60}ms`}>
          <span class={`font-bold ${medalClass[r.medal]}`}>{r.pos}</span>
          <span class="text-ink font-body font-semibold">{r.rider} <span class="font-mono text-ink-dim font-normal text-[11px]">· {r.year}</span></span>
          <span class="hidden md:block text-ink-dim">{r.event} · {r.disc}</span>
          <span class="hidden md:block text-ink-faint">{r.year}</span>
          <span class={`font-bold text-right md:text-left ${medalClass[r.medal]}`}>{r.result}</span>
        </div>
      ))}
    </div>
  </div>
</section>
