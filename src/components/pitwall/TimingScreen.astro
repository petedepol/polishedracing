---
import { palmares, countingRule } from '../../data/palmares';
const medalClass: Record<string,string> = { GOLD: 'text-gold', SILVER: 'text-silver', BRONZE: 'text-bronze', WIN: 'text-signal', LEADER: 'text-signal' };
---
<section id="palmares" class="py-20 scroll-mt-12">
  <div class="max-w-7xl mx-auto px-5 md:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
      <div>
        <p class="section-no mb-3">[03] THE PALMARÈS · TIMING SCREEN</p>
        <h2 class="font-display text-display-md text-ink">CAREER FEED — 2011–2026</h2>
      </div>
      <p class="font-mono text-[11px] tracking-[0.18em] text-ink-dim uppercase flex items-center gap-2"><span class="dot-live"></span>126 TOP FINISHES · LIVE</p>
    </div>

    <!-- desktop: a real table -->
    <div class="hidden md:block hairline bg-carbon-raised">
      <table class="w-full font-mono text-[12px]">
        <thead class="text-ink-dim uppercase tracking-[0.15em] text-[10px]">
          <tr class="border-b border-carbon-line"><th class="text-left py-3 px-4 w-14">POS</th><th class="text-left py-3 px-4">RIDER</th><th class="text-left py-3 px-4">EVENT</th><th class="text-left py-3 px-4 w-20">DISC</th><th class="text-left py-3 px-4">RESULT</th><th class="text-left py-3 px-4 w-16">YEAR</th><th class="text-left py-3 px-4">MY ROLE</th></tr>
        </thead>
        <tbody>
          {palmares.map((r, i) => (
            <tr class="feed-row border-b border-carbon-line hover:bg-carbon hover:shadow-[inset_2px_0_0_#C6FF2E]" style={`transition-delay:${i*45}ms`}>
              <td class={`py-3 px-4 font-bold ${medalClass[r.medal]}`}>{r.pos}</td>
              <td class="py-3 px-4 text-ink">{r.rider}</td>
              <td class="py-3 px-4 text-ink-dim">{r.event}</td>
              <td class="py-3 px-4 text-ink-dim">{r.disc}</td>
              <td class={`py-3 px-4 font-bold tracking-wide ${medalClass[r.medal]}`}>{r.result}</td>
              <td class="py-3 px-4 text-ink-dim">{r.year}</td>
              <td class="py-3 px-4 text-ink-faint">{r.role}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- mobile: stacked cards -->
    <div class="md:hidden space-y-px bg-carbon-line hairline">
      {palmares.map((r, i) => (
        <div class="feed-row bg-carbon-raised p-4" style={`transition-delay:${i*45}ms`}>
          <div class="flex items-start justify-between gap-3">
            <div class="font-body text-ink font-semibold">{r.rider}</div>
            <div class={`font-mono text-[11px] font-bold tracking-wide text-right ${medalClass[r.medal]}`}>{r.pos} · {r.result}</div>
          </div>
          <div class="font-mono text-[10px] text-ink-dim mt-2">{r.event} · {r.disc} · {r.year}</div>
          <div class="font-mono text-[10px] text-ink-faint mt-1">{r.role}</div>
        </div>
      ))}
    </div>

    <p class="font-mono text-[10px] tracking-[0.12em] text-ink-faint mt-4 leading-relaxed">* {countingRule}</p>
  </div>
</section>
