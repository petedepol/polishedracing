---
const categories = ['All', 'Race Day', 'Workshop', 'Atherton Bikes', 'Team'];

// Placeholder gallery items - replace with real images
const galleryItems = [
  { id: 1, category: 'Race Day', title: 'World Cup Finals', aspect: 'aspect-[4/3]' },
  { id: 2, category: 'Workshop', title: 'Suspension Setup', aspect: 'aspect-[3/4]' },
  { id: 3, category: 'Atherton Bikes', title: 'Titanium Frame', aspect: 'aspect-square' },
  { id: 4, category: 'Race Day', title: 'Pit Lane', aspect: 'aspect-[4/3]' },
  { id: 5, category: 'Team', title: 'Trek Factory Racing', aspect: 'aspect-[3/4]' },
  { id: 6, category: 'Workshop', title: 'Wheel Build', aspect: 'aspect-square' },
  { id: 7, category: 'Atherton Bikes', title: '3D Print Detail', aspect: 'aspect-[4/3]' },
  { id: 8, category: 'Race Day', title: 'Red Bull Hardline', aspect: 'aspect-[3/4]' },
  { id: 9, category: 'Team', title: 'Atherton Racing', aspect: 'aspect-square' },
];
---
<!-- Filter Tabs -->
<div class="flex flex-wrap gap-2 mb-10">
  {categories.map((cat) => (
    <button
      class={`gallery-filter px-4 py-2 text-xs font-medium uppercase tracking-widest rounded-full border transition-all duration-300 ${cat === 'All' ? 'bg-accent-red border-accent-red text-white' : 'border-white/10 text-text-secondary hover:border-white/30 hover:text-white'}`}
      data-category={cat}
    >
      {cat}
    </button>
  ))}
</div>

<!-- Grid -->
<div id="gallery-grid" class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4">
  {galleryItems.map((item) => (
    <div
      class="gallery-item break-inside-avoid cursor-pointer group"
      data-category={item.category}
    >
      <div class={`${item.aspect} bg-bg-raised rounded-lg overflow-hidden relative`}>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="text-center">
            <div class="w-12 h-12 mx-auto mb-3 border border-white/10 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-text-muted">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
              </svg>
            </div>
            <p class="text-xs text-text-muted">{item.title}</p>
          </div>
        </div>
        <!-- Hover overlay -->
        <div class="absolute inset-0 bg-accent-red/0 group-hover:bg-accent-red/20 transition-colors duration-300 rounded-lg"></div>
        <div class="absolute inset-0 border border-white/5 group-hover:border-white/10 rounded-lg transition-colors duration-300"></div>
      </div>
    </div>
  ))}
</div>

<!-- Lightbox -->
<div id="lightbox" class="fixed inset-0 z-[100] bg-bg/95 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 flex items-center justify-center">
  <button id="lightbox-close" class="absolute top-6 right-6 text-white hover:text-accent-red transition-colors" aria-label="Close lightbox">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
    </svg>
  </button>
  <div id="lightbox-content" class="max-w-5xl max-h-[80vh] mx-6">
    <div class="aspect-video bg-bg-raised rounded-lg flex items-center justify-center">
      <p class="text-text-muted text-sm">Image will appear here when photos are added</p>
    </div>
  </div>
  <button id="lightbox-prev" class="absolute left-6 top-1/2 -translate-y-1/2 text-white hover:text-accent-red transition-colors" aria-label="Previous image">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="m15 18-6-6 6-6"/>
    </svg>
  </button>
  <button id="lightbox-next" class="absolute right-6 top-1/2 -translate-y-1/2 text-white hover:text-accent-red transition-colors" aria-label="Next image">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="m9 18 6-6-6-6"/>
    </svg>
  </button>
</div>

<script>
  // Filter functionality
  const filters = document.querySelectorAll('.gallery-filter');
  const items = document.querySelectorAll('.gallery-item');

  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const category = filter.getAttribute('data-category');

      // Update active filter
      filters.forEach((f) => {
        f.classList.remove('bg-accent-red', 'border-accent-red', 'text-white');
        f.classList.add('border-white/10', 'text-text-secondary');
      });
      filter.classList.add('bg-accent-red', 'border-accent-red', 'text-white');
      filter.classList.remove('border-white/10', 'text-text-secondary');

      // Filter items
      items.forEach((item) => {
        const itemCat = item.getAttribute('data-category');
        if (category === 'All' || itemCat === category) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Lightbox
  const lightbox = document.getElementById('lightbox');
  const lightboxClose = document.getElementById('lightbox-close');

  items.forEach((item) => {
    item.addEventListener('click', () => {
      if (lightbox) {
        lightbox.classList.remove('opacity-0', 'pointer-events-none');
        lightbox.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('opacity-0', 'pointer-events-none');
      lightbox.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
    }
  }

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
