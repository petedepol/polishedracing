---
import PageLayout from '../layouts/PageLayout.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import { socialLinks } from '../data/social-links';
---
<PageLayout
  title="Contact — Pete Michaliszyn | Polished Racing"
  heading="Get in Touch"
  subheading="Whether it's a race team, a bike project, or just a conversation about downhill — I'd love to hear from you."
>
  <section class="pb-20 md:pb-32">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20">
        <!-- Form -->
        <ContactForm />

        <!-- Info sidebar -->
        <div class="space-y-10">
          <!-- Availability -->
          <div>
            <h3 class="font-display text-xl uppercase text-white mb-4">Availability</h3>
            <div class="flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-green-500 animate-pulse"></span>
              <span class="text-text-secondary">Available for new opportunities</span>
            </div>
          </div>

          <!-- What I can help with -->
          <div>
            <h3 class="font-display text-xl uppercase text-white mb-4">What I Can Help With</h3>
            <ul class="space-y-3 text-text-secondary">
              <li class="flex items-start gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-accent-red mt-2 flex-shrink-0"></span>
                Race team mechanics & technical support
              </li>
              <li class="flex items-start gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-accent-red mt-2 flex-shrink-0"></span>
                Bike builds & suspension setup
              </li>
              <li class="flex items-start gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-accent-red mt-2 flex-shrink-0"></span>
                Technical consulting & brand partnerships
              </li>
              <li class="flex items-start gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-accent-red mt-2 flex-shrink-0"></span>
                Workshop training & skills development
              </li>
            </ul>
          </div>

          <!-- Social links -->
          <div>
            <h3 class="font-display text-xl uppercase text-white mb-4">Connect</h3>
            <div class="flex flex-col gap-3">
              {socialLinks.map((link) => (
                <a
                  href={link.url}
                  target={link.platform !== 'Email' ? '_blank' : undefined}
                  rel={link.platform !== 'Email' ? 'noopener noreferrer' : undefined}
                  class="flex items-center gap-3 text-text-secondary hover:text-white transition-colors group"
                >
                  <span class="text-text-muted group-hover:text-accent-red transition-colors">
                    <Fragment set:html={link.icon} />
                  </span>
                  {link.platform}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
