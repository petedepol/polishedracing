---
import PageLayout from '../layouts/PageLayout.astro';
import TimelineTrack from '../components/timeline/TimelineTrack.astro';
---
<PageLayout
  title="Timeline — Pete Michaliszyn | Polished Racing"
  heading="Timeline"
  subheading="From a ZX Spectrum in Bielawa to the World Cup paddock — and beyond."
>
  <section class="pb-20 md:pb-32">
    <div class="max-w-4xl mx-auto px-6">
      <!-- Category legend -->
      <div class="flex flex-wrap gap-4 mb-12">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-accent-red"></span>
          <span class="text-xs uppercase tracking-widest text-text-muted">Racing</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-accent-cyan"></span>
          <span class="text-xs uppercase tracking-widest text-text-muted">Team</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-accent-orange"></span>
          <span class="text-xs uppercase tracking-widest text-text-muted">Milestone</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-white"></span>
          <span class="text-xs uppercase tracking-widest text-text-muted">Personal</span>
        </div>
      </div>

      <TimelineTrack />
    </div>
  </section>
</PageLayout>
