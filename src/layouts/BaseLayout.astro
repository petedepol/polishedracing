---
import '../styles/global.css';
import { siteConfig } from '../data/site-config';
interface Props { title?: string; description?: string; }
const { title = siteConfig.title, description = siteConfig.description } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0B0D" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "Person",
      "name": "Pete Michaliszyn", "alternateName": "Polish Pete",
      "jobTitle": "World Cup mountain bike mechanic — head mechanic",
      "url": siteConfig.url, "email": siteConfig.email, "telephone": siteConfig.phone,
      "sameAs": [siteConfig.linkedin],
      "worksFor": { "@type": "SportsTeam", "name": "Cannondale Factory Racing" },
      "knowsAbout": ["Mountain bike mechanics", "Suspension setup", "Race data analysis", "UCI Mountain Bike World Cup"]
    })} />
  </head>
  <body class="bg-carbon text-ink font-body">
    <div class="film-grain" aria-hidden="true"></div>
    <slot />
    <script>
      // Reveal + feed stream-in + count-ups. Deletable in 5 minutes: remove this block and everything still renders.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          e.target.querySelectorAll('.count').forEach((el) => {
            const target = Number((el as HTMLElement).dataset.count || 0);
            const start = performance.now(); const dur = 900;
            const tick = (t: number) => { const p = Math.min(1, (t - start) / dur); const eased = 1 - Math.pow(1 - p, 4); (el as HTMLElement).textContent = String(Math.round(target * eased)); if (p < 1) requestAnimationFrame(tick); };
            requestAnimationFrame(tick);
          });
          io.unobserve(e.target);
        }
      }, { threshold: 0.15 });
      document.querySelectorAll('.reveal, .feed-row, .exploded').forEach((el) => io.observe(el));
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll('.count').forEach((el) => { (el as HTMLElement).textContent = (el as HTMLElement).dataset.count || ''; });
    </script>
  </body>
</html>
