---
import '../styles/global.css';
import { siteConfig } from '../data/site-config';
import bebasUrl from '@fontsource/bebas-neue/files/bebas-neue-latin-400-normal.woff2?url';
import plexUrl from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import monoUrl from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
interface Props { title?: string; description?: string; }
const { title = siteConfig.title, description = siteConfig.description } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0B0D" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site).href} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" as="font" type="font/woff2" crossorigin href={bebasUrl} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={plexUrl} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={monoUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "Person",
      "name": "Pete Michaliszyn", "alternateName": "Polish Pete",
      "jobTitle": "World Cup mountain bike mechanic — head mechanic",
      "url": siteConfig.url, "email": siteConfig.email, "telephone": siteConfig.phone,
      "worksFor": { "@type": "SportsTeam", "name": "Cannondale Factory Racing" },
      "knowsAbout": ["Mountain bike mechanics", "Suspension setup", "Race data analysis", "UCI Mountain Bike World Cup"]
    })} />
  </head>
  <body class="bg-carbon text-ink font-body">
    <div class="film-grain" aria-hidden="true"></div>
    <slot />
    <script src="../scripts/pitwall.ts"></script>
  </body>
</html>
