---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  heading: string;
  subheading?: string;
}

const { title, description, heading, subheading } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <section class="pt-32 pb-16 md:pt-40 md:pb-20">
    <div class="max-w-7xl mx-auto px-6">
      <h1 class="font-display text-display-lg uppercase text-white">{heading}</h1>
      {subheading && (
        <p class="mt-4 text-lg md:text-xl text-text-secondary max-w-2xl">{subheading}</p>
      )}
    </div>
  </section>
  <slot />
</BaseLayout>
